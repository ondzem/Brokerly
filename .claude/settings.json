{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ondrejzeman/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ondrejzeman/.local/bin/graphify hook-guard read --strict"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/sync.sh\" pull SessionStart",
            "timeout": 30,
            "statusMessage": "Stahuji změny od kolegy…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/sync.sh\" push",
            "timeout": 60,
            "statusMessage": "Nahrávám na GitHub…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/sync.sh\" pull UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "Kontroluji, jestli kolega něco nenahrál…"
          }
        ]
      }
    ]
  }
}
