# Zkopírujte tento soubor na .env.local a doplňte hodnoty:
#   cp .env.local.example .env.local
#
# .env.local je v .gitignore — na GitHub se NIKDY nenahraje.
# Hodnoty vám pošle Ondřej soukromě (ne e-mailem do skupiny, ne do issue).

# Supabase — společná databáze, oba se připojujete ke stejné.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — čte inzerát a vytáhne z něj údaje (bleskový import).
# https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# ScraperAPI — stáhne HTML inzerátu ze Sreality apod.
# https://www.scraperapi.com → Dashboard
NEXT_PUBLIC_SCRAPER_API_KEY=

# Supabase přístupový token — umožní Claude Code spouštět migrace databáze
# za vás (python3 scripts/db-push.py). Bez něj se migrace musí lepit ručně
# do SQL editoru. Vytvoří se na https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
